# Copia este archivo como .env.local y rellena los dos valores de tu proyecto de Supabase
# (Supabase → Project Settings → API). Sin ellos la app funciona en "modo local":
# todo se guarda solo en el móvil, como la versión 0.
#
# La clave "anon" es pública por diseño (los permisos los aplica la base de datos).
# NUNCA pongas aquí la clave "service_role".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
