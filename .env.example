# Copia este archivo como .env.local y rellena los dos valores de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys). Sin ellos la app funciona en "modo local":
# todo se guarda solo en el móvil, como la versión 0.
#
# La clave "publishable" (sb_publishable_…) es pública por diseño: los permisos los aplica la base de datos.
# Si tu proyecto usa las claves antiguas, puedes usar VITE_SUPABASE_ANON_KEY con la clave "anon".
# NUNCA pongas aquí la clave secreta (sb_secret_…) ni la "service_role".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
